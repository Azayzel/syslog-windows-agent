<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AssemblyName>Jakkl</AssemblyName>
    <RootNamespace>Jakkl</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Title>Jakkl Event Monitoring</Title>
    <Description>Real-time Windows Event Monitoring and Syslog forwarding agent</Description>
    <Product>Jakkl - Syslog Windows Agent</Product>
    <Copyright>2019-2026 Josh Lavely</Copyright>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="events.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico" />
    <Content Include="jakkl_sm.png" />
    <Content Include="jakkl_syslog_windows.png" />
  </ItemGroup>

</Project>
